SSL /\/DC=EU\/DC=EGI\/C=HR\/O=Robots\/O=SRCE\/CN=Robot:argo-egi@cro-ngi.hr,.*/ ops005
SSL /\/DC=EU\/DC=EGI\/C=GR\/O=Robots\/O=Greek Research and Technology Network\/CN=Robot:argo-secmon@grnet.gr,.*/ ops007
{%- endif %}
{% endif %}

